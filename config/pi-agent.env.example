# ~/.config/pi-agent/pi-agent.env (mode 0600), created from this file by
# scripts/install.sh on the first run.
#
# Read only by the install/upgrade scripts, which render these values into the
# units (decision D2). systemd and podman never read this file.
# One KEY=value per line: no quotes, no "export", no comments after a value.

# Container timezone, an IANA name.
PI_TZ=Asia/Taipei

# true: full image with the video toolchain (ffmpeg, Playwright-Chromium, CJK
# fonts, rclone), tagged localhost/woow-podman-pi-agent-host:<version>-r<n>.
# false: slim image built with VIDEO_TOOLS=0, tagged ...-slim, and the unit gets
# VIDEO_PIPELINE_ENABLED=false. Changing it rebuilds the image and restarts pi-web.
PI_VIDEO_TOOLS=true
