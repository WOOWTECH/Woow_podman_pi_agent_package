# Private bridge for the stack. netavark's aardvark-dns resolves container
# names on it, which is how nginx finds pi-web without any hardcoded IP and
# without the two containers having to share a network namespace.
#
# Sharing a namespace (a Podman pod) would also work and is what the k3s
# deployment did — but only because ttyd had to sit on the same localhost as
# pi-web. With ttyd gone, a plain network is the simpler and more Podman-native
# arrangement, and it does not need the .pod unit type that Podman 4.9 lacks.
[Unit]
Description=pi-agent private network

[Network]
NetworkName=pi-agent

[Install]
WantedBy=default.target
